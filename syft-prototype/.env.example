# Syft prototype — open-source / free-tier model config.
# Embeddings run locally (Transformers.js, all-MiniLM-L6-v2) — NO key needed.
# Only the LLM backend needs configuring. Copy to .env.

# --- Option A: Groq free tier (recommended) — open Llama models, fast, free key ---
#   Get a free key at https://console.groq.com/keys
LLM_API_KEY=gsk_...
# LLM_BASE_URL defaults to https://api.groq.com/openai/v1
# LLM_MODEL defaults to llama-3.1-8b-instant (parse/narrate)
# LLM_REASON_MODEL defaults to llama-3.3-70b-versatile (Stage-3 reasoning)

# --- Option B: Ollama (fully local, NO key) ---
#   Install from https://ollama.com, then: ollama pull llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# LLM_REASON_MODEL=llama3.1

# --- Option C: OpenRouter free models ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_REASON_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: override the local embedding model (any Transformers.js feature-extraction model)
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Voice: OpenAI Whisper (STT) + TTS for the Stage 3 "Let's talk" interview ---
#   Optional. Without OPENAI_API_KEY, the interview falls back to the browser's
#   built-in SpeechRecognition / SpeechSynthesis (works, but browser-dependent).
#   With a key, answers are transcribed by Whisper and questions are spoken by TTS.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for an OpenAI-compatible host
# WHISPER_MODEL=whisper-1                      # speech-to-text model
# TTS_MODEL=tts-1                              # text-to-speech model
# TTS_VOICE=shimmer                            # alloy | echo | fable | onyx | nova | shimmer

# --- Auth: Supabase (free tier) ---
#   Create a free project at https://supabase.com → Project Settings → API.
#   These are public/browser-safe (the anon key is gated by Row Level Security).
#   Without them the app runs in demo mode (onboarding passes through, no real auth).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Data layer: Supabase Postgres + pgvector ---
#   SERVER-ONLY service-role key (Project Settings → API → service_role). Bypasses
#   Row Level Security — used to seed the pool, read the full pool for matching, and
#   write a user's embedded profile. NEVER expose this to the browser / commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
